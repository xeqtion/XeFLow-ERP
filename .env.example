# XeFlow deployment template. Copy to .env and replace every CHANGE_ME value.

# Database and session store
MYSQL_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_ROOT_PASSWORD
MYSQL_DB=erp
MYSQL_USER=xeflow
MYSQL_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD

# Application security
ERP_JWT_SECRET=CHANGE_ME_AT_LEAST_64_RANDOM_CHARACTERS
ERP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_12_CHARS_WITH_UPPER_LOWER_NUMBER_SYMBOL
ERP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ERP_CORS_ORIGINS=

# Organization shown in exported shipment documents
ERP_COMPANY_NAME=XeFlow Demo Company
ERP_COMPANY_ADDRESS_LINE_1=Configure your company address
ERP_COMPANY_ADDRESS_LINE_2=
ERP_COMPANY_WEBSITE=https://example.com
ERP_COMPANY_CONTACT=Configure your company contact
ERP_COMPANY_SHIPPING_MARK=XeFlow
ERP_COMPANY_BANK_ACCOUNT_NAME=
ERP_COMPANY_BANK_NAME=
ERP_COMPANY_BANK_ACCOUNT_NO=
ERP_COMPANY_BANK_ADDRESS=
ERP_COMPANY_BANK_SWIFT_CODE=
ERP_COMPANY_BANK_CURRENCY=USD

# Registration is disabled by default. Enable it only with invitation codes.
ERP_REGISTER_ENABLED=false
ERP_REGISTER_DOMAINS=
ERP_REGISTER_REQUIRE_EMAIL_CODE=false
ERP_REGISTER_APPROVAL=true

# Optional SMTP. Leave ERP_MAIL_ENABLED=false when not configured.
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SSL=true
MAIL_STARTTLS=false
ERP_MAIL_ENABLED=false
ERP_MAIL_FROM=XeFlow <noreply@example.com>

# Optional public HTTPS endpoint for Caddy
XEFLOW_DOMAIN=localhost
ACME_EMAIL=admin@example.com
