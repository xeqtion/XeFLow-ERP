{$XEFLOW_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8081

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
